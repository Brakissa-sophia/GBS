{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Panier{% endblock %}
{% block description %}{{ parent() }} | Panier{% endblock %}
{% block keywords %}{{ parent() }} | Panier{% endblock %}

{% block body %}
<div class="container-fluid py-3 py-md-4">
    <div class="row g-3">
        <!-- Section Panier -->
        <div class="{% if subtotal > 0 %}col-12 col-lg-8{% else %}col-12{% endif %} order-2 order-lg-1">
            <div class="card shadow-sm rounded-3 border-0">
                <div class="table-responsive">
                    <table class="table table-borderless mb-0">
                        <thead>
                            <tr>
                                <th class="py-2 py-md-3 px-3 px-md-4 text-white fw-medium">Panier</th>
                                <th class="py-2 py-md-3 px-3 px-md-4 text-white fw-medium text-center d-none d-md-table-cell">Prix</th>
                                <th class="py-2 py-md-3 px-3 px-md-4 text-white fw-medium text-center">Quantité</th>
                                <th class="py-2 py-md-3 px-3 px-md-4 text-white fw-medium text-center">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                            <tr class="border-bottom">
                                <td class="py-3 py-md-4 px-3 px-md-4">
                                    <div class="d-flex flex-column flex-md-row align-items-center">
                                        <a href="{{ path('app_cart_remove', {'type': item.type, 'id': item.product.id}) }}" 
                                           class="btn btn-sm btn-outline-danger border-0 me-md-3 rounded-circle p-2 text-muted remove-item"
                                           onclick="return confirm('Voulez-vous vraiment retirer cet article du panier ?');"
                                           title="Supprimer">
                                            <i class="fas fa-times"></i>
                                        </a>
                                        
                                        {% if item.image and item.image != '/images/no-image.jpg' %}
                                            <img src="{{ asset(item.image) }}" alt="{{ item.product.title }}" class="rounded-2 mb-2 mb-md-0 me-md-3" style="width: 60px; height: 60px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-light rounded-2 d-flex align-items-center justify-content-center mb-2 mb-md-0 me-md-3" style="width: 60px; height: 60px;">
                                                <small class="text-muted fw-bold">IMG</small>
                                            </div>
                                        {% endif %}
                                        <span class="fw-medium text-dark text-center text-md-start">{{ item.product.title }}</span>
                                        <div class="d-md-none mt-2">
                                            <span class="fw-medium">€{{ item.product.price }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 py-md-4 px-3 px-md-4 text-center align-middle d-none d-md-table-cell">
                                    <span class="fw-medium">€{{ item.product.price }}</span>
                                </td>
                                <td class="py-3 py-md-4 px-3 px-md-4 text-center align-middle">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <a href="{{ path('app_cart_update_quantity', {'type': item.type, 'id': item.product.id, 'action': 'decrease'}) }}" 
                                           class="btn btn-sm btn-outline-secondary border rounded-1 d-flex align-items-center justify-content-center text-decoration-none" 
                                           style="width: 25px; height: 25px;">−</a>
                                        
                                        <span class="mx-2 mx-md-3 fw-medium">{{ item.quantity }}</span>
                                        
                                        <a href="{{ path('app_cart_update_quantity', {'type': item.type, 'id': item.product.id, 'action': 'increase'}) }}" 
                                           class="btn btn-sm btn-outline-secondary border rounded-1 d-flex align-items-center justify-content-center text-decoration-none" 
                                           style="width: 25px; height: 25px;">+</a>
                                    </div>
                                </td>
                                <td class="py-3 py-md-4 px-3 px-md-4 text-center align-middle">
                                    <span class="fw-bold">€{{ (item.product.price * item.quantity)|number_format(2, '.', '') }}</span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-4 py-md-5 text-muted">
                                    <i class="fas fa-shopping-cart fa-3x mb-3 opacity-50"></i>
                                    <p class="mb-0">Votre panier est vide</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if subtotal > 0 %}
                <div class="mt-3">
                    <a href="{{ path('app_cart_clear') }}" 
                       class="btn btn-outline-danger"
                       onclick="return confirm('Êtes-vous sûr de vouloir vider votre panier ?');">
                        Vider le panier
                    </a>
                </div>
            {% endif %}
        </div>
        
        <!-- Section Sidebar -->
        {% if subtotal > 0 %}
        <div class="col-12 col-lg-4 order-1 order-lg-2 mb-3 mb-lg-0">
            <div class="card shadow-sm rounded-3 border-0">
                <table class="table table-borderless mb-0">
                    <thead class="cart-header">
                        <tr>
                            <th class="py-3 px-4 text-white fw-medium">Paiements</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="p-4">
                                <!-- Messages flash -->
                                {% for type, messages in app.flashes %}
                                    {% for message in messages %}
                                        <div class="alert alert-{{ type }} alert-dismissible fade show mb-3" role="alert">
                                            {{ message }}
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    {% endfor %}
                                {% endfor %}

                                <!-- Message livraison gratuite -->
                                {% if subtotal > 0 and subtotal < 49 %}
                                    <div class="alert alert-info small mb-3">
                                        Plus que €{{ (49 - subtotal)|number_format(2, '.', ',') }} pour bénéficier de la livraison gratuite !
                                    </div>
                                {% endif %}
                                
                                <!-- Sous-total -->
                                <div class="d-flex justify-content-between text-muted mb-2">
                                    <span>Sous-total</span>
                                    <span>€{{ subtotal|number_format(2, '.', '') }}</span>
                                </div>

                                <!-- Code promo section -->
                                <div class="border-top pt-3 mt-3 mb-3">
                                    <div class="text-muted mb-3">Code promo</div>

                                    {% if appliedPromo %}
                                        <!-- Code promo appliqué -->
                                        <div class="d-flex justify-content-between align-items-center p-3 bg-success bg-opacity-10 rounded mb-3">
                                            <div>
                                                <small class="text-success fw-medium">Code appliqué :</small>
                                                <strong class="d-block">{{ appliedPromo }}</strong>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removePromo()" title="Retirer">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    {% else %}
                                        <!-- Formulaire code promo -->
                                        <form onsubmit="applyPromo(event)" class="d-flex gap-2">
                                            <input 
                                                type="text" 
                                                id="promo-input"
                                                name="promo_code" 
                                                class="form-control form-control" 
                                                required>
                                            <button type="submit" class="btn-sage btn-sm rounded px-2">
                                                Appliquer
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>

                                <!-- Réduction -->
                                {% if discount > 0 %}
                                <div class="border-top pt-3 mt-3">
                                    <div class="d-flex justify-content-between text-success mb-2">
                                        <span>Réduction</span>
                                        <span>-€{{ discount|number_format(2, '.', '') }}</span>
                                    </div>
                                </div>
                                {% endif %}

                                <!-- Expédition -->
                                <div class="d-flex justify-content-between text-muted mb-4">
                                    <span>Expédition</span>
                                    <span>{% if subtotalAfterDiscount >= 49 %}Gratuit{% else %}€5.99{% endif %}</span>
                                </div>
                                
                                <!-- Total final -->
                                <div class="border-top pt-3 mb-4">
                                    <div class="d-flex justify-content-between fw-bold fs-5">
                                        <span>TOTAL</span>
                                        <span>€{{ finalTotal|number_format(2, '.', '') }}</span>
                                    </div>
                                </div>

                                <a href="{{ path('app_order') }}" class="text-decoration-none">
                                    <button class="btn btn-dark w-100 py-3 fw-semibold rounded-2 mb-4">
                                        Continuer vers l'expédition
                                    </button>
                                </a>
                                
                                <!-- Moyens de paiement -->
                                <div class="d-flex gap-2 align-items-center justify-content-center flex-wrap">
                                    <div class="payment-methods">
                                        <img src="{{ asset('images/visa.png') }}" alt="visa" class="img-fluid" style="height: 25px;">
                                    </div>
                                    <div class="payment-methods">
                                        <img src="{{ asset('images/paypal.png') }}" alt="paypal" class="img-fluid" style="height: 25px;">
                                    </div>
                                    <div class="payment-methods">
                                        <img src="{{ asset('images/mastercard.png') }}" alt="mastercard" class="img-fluid" style="height: 25px;">
                                    </div>
                                    <div class="payment-methods">
                                        <img src="{{ asset('images/amex.png') }}" alt="american express" class="img-fluid" style="height: 25px;">
                                    </div>
                                    <div class="payment-methods">
                                        <img src="{{ asset('images/jcb.png') }}" alt="jcb" class="img-fluid" style="height: 25px;">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
function applyPromo(e) {
    e.preventDefault();
    const code = document.getElementById('promo-input').value;
    
    fetch('{{ path('api_promo_validate') }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({code: code})
    })
    .then(r => r.json())
    .then(d => {
        if(d.success) location.reload();
        else alert(d.message);
    });
}

function removePromo() {
    fetch('{{ path('api_promo_remove') }}', {method: 'POST'})
    .then(() => location.reload());
}
</script>

{% endblock %}