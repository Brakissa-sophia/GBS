{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Produit ajouter {% endblock %}
{% block description %}{{ parent() }} | Produit ajouter {% endblock %}
{% block keywords %}{{ parent() }} | Produit ajouter {% endblock %}

{% block body %}
<h2>Ajouter un produit</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_product_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

{{ form_start(formProduct) }}

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header bg-primary">
                <h5 class="mb-0 text-dark">Informations générales</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formProduct.title) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formProduct.price) }}
                    </div>
                </div>
                {{ form_row(formProduct.description) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-success">
                <h5 class="mb-0 text-dark">Détails du produit</h5>
            </div>
            <div class="card-body">
                {{ form_row(formProduct.ingredients) }}
                {{ form_row(formProduct.usageAdvice) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-secondary">
                <h5 class="mb-0 text-dark">Images</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formProduct.image1) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formProduct.image2) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formProduct.image3) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formProduct.image4) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header bg-info">
                <h5 class="mb-0 text-dark">Classification</h5>
            </div>
            <div class="card-body">
                {{ form_row(formProduct.category) }}
                {{ form_row(formProduct.brand) }}
                {{ form_row(formProduct.skinType) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Stock initial</h5>
            </div>
            <div class="card-body">
                {{ form_row(formProduct.stock) }}
            </div>
        </div>
    </div>
</div>

{{ form_rest(formProduct) }}

<div class="row mt-3">
    <div class="col-12">
        <button type="submit" class="btn btn-dark">Ajouter le produit</button>
        <a href="{{ path('app_product_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>
</div>

{{ form_end(formProduct) }}

{% endblock %}