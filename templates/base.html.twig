<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}{{ compagny }}{% endblock %}</title>
    
    <meta name="description" content="{% block description %}{{ compagny }}Glow Beauty Skin est une boutique en ligne spécialisée en skincare coréen. Découvrez une sélection de produits doux, efficaces et adaptés à chaque type de peau, pour révéler votre éclat naturel. Produits testés, actifs reconnus, résultats visibles.{% endblock %}"> 
    <meta name="keywords" content="{% block keywords %}{{ compagny }}{% endblock %}">
    <link rel="icon" href="{{ asset('images/log.png') }}">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Raleway:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    {% block stylesheets %}{% endblock %}
</head>

<body>
  {{ flasher_render() }}  

  {% include '_include/_header.html.twig' %}
   
  <main class="min-vh-100 container main-content">
      
             
      {% block body %}{% endblock %}
  </main> 

  {% include '_include/_footer.html.twig' %}

{# ===== Modal Newsletter ===== #}
<div class="modal fade" id="newsletterModal" tabindex="-1" aria-labelledby="newsletterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 rounded-3 overflow-hidden">

      
      <div class="bg-sage position-relative" style="height: 50px;">
        <button type="button"
                class="btn-close btn-close-white position-absolute top-50 end-0 translate-middle-y me-3"
                data-bs-dismiss="modal"
                aria-label="Fermer"></button>
      </div>

      
      <img
        src="{{ asset('images/newsletter_img.avif') }}"
        alt="Illustration Glow Beauty Skin"
        class="img-fluid w-100 newsletter-hero">

      
      <div class="modal-body text-center py-4">
  <h2 id="newsletterTitle" class="h4 mb-3">Rejoignez la Newsletter Glow Beauty Skin</h2>

  <p class="text-muted mb-3">
    Soyez informé(e) en avant-première de nos <strong>nouveautés</strong>, de nos lancements exclusifs 
    et des offres réservées à notre communauté.
  </p>

  <p class="fw-semibold text-success mb-4">
    Et pour bien commencer, profitez d’un <strong>code de réduction de -10%</strong> 
    sur votre première commande, envoyé directement par email après votre inscription 🎁
  </p>

  <form action="{{ path('app_newsletter_subscribe') }}" method="POST" id="newsletterForm" novalidate class="container px-0">
    <div class="row g-2 justify-content-center">
      <div class="col-12 col-md-10">
        <input
          type="email"
          name="newsletter_email"
          class="form-control"
          placeholder="Votre adresse email"
          required
          autocomplete="email"
          inputmode="email">
      </div>
      <div class="col-12 col-md-auto d-grid d-md-inline">
        <button type="submit" class="btn btn-sage px-4">S’inscrire</button>
      </div>
    </div>
  </form>
</div>


    </div>
  </div>
</div>
{# ===== /Modal Newsletter ===== #}


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('newsletterModal');
    if (!el) return;

    // Empêche fermeture par clic sur le fond → vrai blocage
    const modal = new bootstrap.Modal(el, { backdrop: 'static', keyboard: true });

    // Ouvre après 3 secondes si non inscrit
    setTimeout(function () {
      if (!localStorage.getItem('newsletterSubscribed')) {
        modal.show();
      }
    }, 3000);

    // Mémorise inscription
    const form = document.getElementById('newsletterForm');
    if (form) {
      form.addEventListener('submit', function () {
        localStorage.setItem('newsletterSubscribed', 'true');
      });
    }

    // Pour tests manuels en console
    window.gbsOpenNewsletter = () => modal.show();
  });
  </script>

  {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
  {% endblock %}
</body>
</html>
 