{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Contact {% endblock %}
{% block description %}{{ parent() }} | Contact {% endblock %}
{% block keywords %}{{ parent() }} | Contact {% endblock %}

{% block body %}
<div class="contact-page min-vh-100 d-flex align-items-start pt-5 py-lg-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7">
                
                {# ✅ Affichage des messages flash #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show mb-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                
                <div class="carte-contact rounded-3 shadow p-4 p-md-5">
                    
                    <div class="text-center mb-4">
                        <h2 class="mb-3">Contactez-Nous</h2>
                        <p class="text-muted">Nous serions ravis d'entendre parler de vous</p>
                    </div>
                    
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="mb-3">
                                {{ form_label(form.name, 'Nom', {'label_attr': {'class': 'form-label text-muted fw-medium'}}) }}
                                {{ form_widget(form.name, {'attr': {'class': 'form-control form-control-lg bg-light border-1 rounded-2', 'placeholder': 'Votre nom complet'}}) }}
                                {{ form_errors(form.name) }}
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label text-muted fw-medium'}}) }}
                                {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg bg-light border-1 rounded-2', 'placeholder': 'votre@email.com'}}) }}
                                {{ form_errors(form.email) }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.message, 'Message', {'label_attr': {'class': 'form-label text-muted fw-medium'}}) }}
                        {{ form_widget(form.message, {'attr': {'class': 'form-control form-control-lg bg-light border-1 rounded-2', 'rows': '5', 'placeholder': 'Votre message...'}}) }}
                        {{ form_errors(form.message) }}
                    </div>
                    
                    {{ form_rest(form) }}
                    
                    <div class="mt-4">
                        <button type="submit" class="submit-btn w-100 rounded-2 fw-semibold">
                            Envoyer le message
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}