{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Modifier type de peau{% endblock %}
{% block description %}{{ parent() }} | Modifier type de peau{% endblock %}
{% block keywords %}{{ parent() }} | Modifier type de peau{% endblock %}

{% block body %}
<h2>Modifier le type de peau "{{ skin_type.title|capitalize }}"</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_skin_type_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0 text-dark">Modification du type de peau</h5>
            </div>
            <div class="card-body">
                {{ include('skin_type/_form.html.twig', {'button_label': 'Enregistrer'}) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-danger">
                <h5 class="mb-0 text-white">Zone de danger</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">La suppression de ce type de peau est irréversible.</p>
                <form method="post" action="{{ path('app_skin_type_delete', {'id': skin_type.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce type de peau ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ skin_type.id) }}">
                    <button type="submit" class="btn btn-danger text-white w-100">
                        <i class="bi bi-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}