{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Ajouter un outil de beauté {% endblock %}
{% block description %}{{ parent() }} | Ajouter un outil de beauté {% endblock %}
{% block keywords %}{{ parent() }} | Ajouter un outil de beauté {% endblock %}

{% block body %}
<h2>Ajouter un outil de beauté</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_device_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

{{ form_start(formDevice) }}

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header bg-primary">
                <h5 class="mb-0 text-dark">Informations générales</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formDevice.title) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formDevice.price) }}
                    </div>
                </div>
                {{ form_row(formDevice.description) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-success">
                <h5 class="mb-0 text-dark">Détails de l'appareil</h5>
            </div>
            <div class="card-body">
                {{ form_row(formDevice.ingredients) }}
                {{ form_row(formDevice.usageAdvice) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-secondary">
                <h5 class="mb-0 text-dark">Images</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formDevice.image1) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formDevice.image2) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(formDevice.image3) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(formDevice.image4) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header bg-info">
                <h5 class="mb-0 text-dark">Classification</h5>
            </div>
            <div class="card-body">
                {{ form_row(formDevice.category) }}
                {{ form_row(formDevice.brand) }}
                {{ form_row(formDevice.skinType) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Stock initial</h5>
            </div>
            <div class="card-body">
                {{ form_row(formDevice.stock) }}
            </div>
        </div>
    </div>
</div>

{{ form_rest(formDevice) }}

<div class="row mt-3">
    <div class="col-12">
        <button type="submit" class="btn btn-dark">Ajouter l'outil de beauté</button>
        <a href="{{ path('app_device_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>
</div>

{{ form_end(formDevice) }}

{% endblock %}