{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Historique stock {% endblock %}
{% block description %}{{ parent() }} | Historique stock {% endblock %}
{% block keywords %}{{ parent() }} | Historique stock {% endblock %}

{% block body %}
<h2>Historique stock : "{{ device.title|capitalize }}"</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_device_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
    <a class="btn btn-primary" href="{{ path('app_device_show', {'id': device.id}) }}">
        <i class="bi bi-eye"></i> Afficher
    </a>
    <a class="btn btn-warning" href="{{ path('app_device_edit',{'id':device.id}) }}">
        <i class="bi bi-pencil"></i> Modifier
    </a>
</div>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-secondary">
                <h5 class="mb-0 text-white">Historique des ajouts de stock</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Quantité</th>
                            <th>Date d'ajout</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for deviceAdded in devicesAdded %}
                        <tr>
                            <td>{{ deviceAdded.id }}</td>
                            <td><span class="badge bg-success">+{{ deviceAdded.qte }}</span></td>
                            <td>{{ deviceAdded.createdAt|date('d/m/Y à H:i') }}</td> 
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted fst-italic">Aucun historique disponible</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info">
                <h5 class="mb-0 text-dark">Informations appareil</h5>
            </div>
            <div class="card-body">
                <p><strong>Appareil :</strong> {{ device.title|capitalize }}</p>
                <p><strong>Stock actuel :</strong></p>
                <div class="text-center mb-3">
                    <span class="badge bg-success fs-4">{{ device.stock }} unités</span>
                </div>
                
                <hr>
                
                <div class="d-grid gap-2">
                    <a href="{{ path('app_device_stock_add', {'id': device.id}) }}" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Ajouter stock
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}