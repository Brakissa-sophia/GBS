{% extends 'base.html.twig' %}

{% block title %}Administration - Commandes{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    
        <h1 class="text-center">Gestion des commandes ({{ orders|length }}) </h1>
    

    {% if orders is empty %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Aucune commande trouvée.
        </div>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Numéro</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th>Produits</th>
                                <th>Devices</th>
                                <th>Total</th>
                                <th>Paiement</th>
                                <th>Statut</th>
                                <th class="text-center">Détails</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for order in orders %}
                            {% set productsCount = 0 %}
                            {% set devicesCount = 0 %}
                            
                            {% for orderProduct in order.orderProducts %}
                                {% if orderProduct.product %}
                                    {% set productsCount = productsCount + orderProduct.qte %}
                                {% endif %}
                                {% if orderProduct.device %}
                                    {% set devicesCount = devicesCount + orderProduct.qte %}
                                {% endif %}
                            {% endfor %}

                            <tr>
                                <td class="fw-bold">#{{ order.id }}</td>
                                <td>
                                    <code>{{ order.orderNumber ?? ('#' ~ ('%06d'|format(order.id))) }}</code>
                                </td>
                                <td>
                                    {% if order.user %}
                                        <div>
                                            <strong>{{ order.user.firstName }} {{ order.user.lastName }}</strong>
                                            <div class="small text-muted">{{ order.user.email }}</div>
                                        </div>
                                    {% else %}
                                        <div>
                                            <strong>{{ order.firstName }} {{ order.lastName }}</strong>
                                            <div class="small text-muted">{{ order.email }}</div>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    <div>{{ order.orderDate|date('d/m/Y') }}</div>
                                    <div class="small text-muted">{{ order.orderDate|date('H:i') }}</div>
                                </td>
                                <td class="text-center">
                                    {% if productsCount > 0 %}
                                        <span>{{ productsCount }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if devicesCount > 0 %}
                                        <span>{{ devicesCount }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td class="fw-bold">
                                    {{ order.totalPrice|number_format(2, ',', ' ') }} €
                                </td>
                                <td>
                                    {% if order.paymentMethod %}
                                        <span class="text-secondary">{{ order.paymentMethod|upper }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set s = order.status %}
                                    <span class="
                                        {% if s == 'payée' %} text-success
                                        {% elseif s == 'en attente' %} text-warning
                                        {% elseif s == 'annulée' %} text-danger
                                        {% elseif s == 'remboursée' %} text-secondary
                                        {% else %} text-dark {% endif %}
                                    ">{{ s|upper }}</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('app_admin_order_details', {id: order.id}) }}" 
                                           class="btn btn-outline-primary" 
                                           title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <button type="button" 
                                                    class="btn btn-outline-secondary" 
                                                    title="Modifier statut"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#statusModal{{ order.id }}">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            
                                            <button type="button" 
                                                    class="btn btn-outline-danger" 
                                                    title="Supprimer"
                                                    onclick="confirmDelete({{ order.id }})">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            {% if is_granted('ROLE_ADMIN') %}
                            <div class="modal fade" id="statusModal{{ order.id }}" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Modifier le statut - Commande #{{ order.id }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        {#<form action="{{ path('app_admin_order_status', {id: order.id}) }}" method="POST">
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label for="status{{ order.id }}" class="form-label">Nouveau statut</label>
                                                    <select class="form-select" id="status{{ order.id }}" name="status" required>
                                                        <option value="pending" {% if order.status == 'pending' %}selected{% endif %}>En attente</option>
                                                        <option value="paid" {% if order.status == 'paid' %}selected{% endif %}>Payée</option>
                                                        <option value="cancelled" {% if order.status == 'cancelled' %}selected{% endif %}>Annulée</option>
                                                        <option value="refunded" {% if order.status == 'refunded' %}selected{% endif %}>Remboursée</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <button type="submit" class="btn btn-primary">Mettre à jour</button>
                                            </div>
                                        </form>#}
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Statistiques rapides (cards gardent leurs badges de couleur) #}
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card bg-primary ">
                    <div class="card-body">
                        <h5 class="text-dark strong">Total commandes</h5>
                        <h3 class="text-dark strong">{{ orders|length }}</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success ">
                    <div class="card-body">
                        <h5 class="text-dark strong">Commandes payées</h5>
                        <h3 class="text-dark strong">{{ orders|filter(o => o.status == 'paid')|length }}</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning">
                    <div class="card-body">
                        <h5 class="text-dark strong">En attente</h5>
                        <h3 class="text-dark strong">{{ orders|filter(o => o.status == 'pending')|length }}</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info ">
                    <div class="card-body">
                        <h5 class="text-dark strong">Chiffre d'affaires</h5>
                        <h3 class="text-dark strong">{{ orders|filter(o => o.status == 'paid')|map(o => o.totalPrice)|reduce((a, b) => a + b, 0)|number_format(0, ',', ' ') }} €</h3>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
function confirmDelete(orderId) {
    if (confirm('Êtes-vous sûr de vouloir supprimer cette commande ? Cette action est irréversible.')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/orders/${orderId}/delete`;
        
        const csrfToken = document.querySelector('meta[name="csrf-token"]');
        if (csrfToken) {
            const csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '_token';
            csrfInput.value = csrfToken.content;
            form.appendChild(csrfInput);
        }
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>

<style>
.table th {
    white-space: nowrap;
}
.btn-group-sm .btn {
    padding: 0.25rem 0.5rem;
}
</style>
{% endblock %}
