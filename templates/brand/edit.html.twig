{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Modifier une marque{% endblock %}
{% block description %}{{ parent() }} | Modifier une marque{% endblock %}
{% block keywords %}{{ parent() }} | Modifier une marque{% endblock %}

{% block body %}
<h2>Modifier la marque "{{ brand.title|capitalize }}"</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_brand_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0 text-dark">Modification de la marque</h5>
            </div>
            <div class="card-body">
                {{ include('brand/_form.html.twig', {'button_label': 'Enregistrer'}) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-danger">
                <h5 class="mb-0 text-white">Zone de danger</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    La suppression de cette marque est <strong>irréversible</strong>.
                </p>

                <form 
                    method="post" 
                    action="{{ path('app_brand_delete', {'id': brand.id}) }}" 
                    onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette marque ?');">
                    
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ brand.id) }}">
                    
                    <button type="submit" class="btn btn-danger text-white w-100">
                        <i class="bi bi-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
