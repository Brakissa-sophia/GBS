{% extends 'base.html.twig' %}

 {% block title %}{{ parent() }} | Modifier mon compte {% endblock %}
 {% block description %}{{ parent() }} | Modifier mon compte  {% endblock %}
 {% block keywords %}{{ parent() }} | Modifier mon compte   {% endblock %}


{% block body %}
<div class="container my-4">
    <h2 class="mb-4">Modifier mes informations</h2>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="bg-white col-md-8 mx-auto p-4 rounded border border-2 border-success">
        {{ form_start(profileForm) }}
        
        <div class="mb-3">
            {{ form_label(profileForm.email) }}
            {{ form_widget(profileForm.email) }}
            {{ form_errors(profileForm.email) }}
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(profileForm.firstName) }}
                {{ form_widget(profileForm.firstName) }}
                {{ form_errors(profileForm.firstName) }}
            </div>

            <div class="col-md-6 mb-3">
                {{ form_label(profileForm.lastName) }}
                {{ form_widget(profileForm.lastName) }}
                {{ form_errors(profileForm.lastName) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(profileForm.sexe) }}
                {{ form_widget(profileForm.sexe) }}
                {{ form_errors(profileForm.sexe) }}
            </div>

            <div class="col-md-6 mb-3">
                {{ form_label(profileForm.birthDate) }}
                {{ form_widget(profileForm.birthDate) }}
                {{ form_errors(profileForm.birthDate) }}
            </div>
        </div>

        <div class="mb-3">
            {{ form_label(profileForm.phone) }}
            {{ form_widget(profileForm.phone) }}
            {{ form_errors(profileForm.phone) }}
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_profile_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Retour
            </a>
            <button type="submit" class="boutonColor">
                <i class="bi bi-check-circle me-1"></i>Enregistrer les modifications
            </button>
        </div>

        {{ form_end(profileForm) }}
    </div>
</div>
{% endblock %}