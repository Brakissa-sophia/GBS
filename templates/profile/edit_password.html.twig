{% extends 'base.html.twig' %}

 {% block title %}{{ parent() }} | Modifier mon mot de passe {% endblock %}
 {% block description %}{{ parent() }} | Modifier mon mot de passe  {% endblock %}
 {% block keywords %}{{ parent() }} | Modifier mon mot de passe   {% endblock %}



{% block body %}
<div class="container my-4">
    <h2 class="mb-4">Modifier mon mot de passe</h2>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="bg-white col-md-6 mx-auto p-4 rounded border border-2 border-success">
        <div class="alert alert-warning sm mb-4 p-2">
            <i class="bi bi-info-circle me-2"></i><small>
            Le mot de passe doit contenir au moins 8 caractères avec au moins une majuscule, une minuscule et un chiffre.</small>
        </div>

        {{ form_start(passwordForm) }}
        
        <div class="mb-3">
            {{ form_label(passwordForm.currentPassword) }}
            {{ form_widget(passwordForm.currentPassword) }}
            {{ form_errors(passwordForm.currentPassword) }}
        </div>

        <div class="mb-3">
            {{ form_label(passwordForm.newPassword.first) }}
            {{ form_widget(passwordForm.newPassword.first) }}
            {{ form_errors(passwordForm.newPassword.first) }}
        </div>

        <div class="mb-3">
            {{ form_label(passwordForm.newPassword.second) }}
            {{ form_widget(passwordForm.newPassword.second) }}
            {{ form_errors(passwordForm.newPassword.second) }}
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_profile_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Retour
            </a>
            <button type="submit" class="boutonColor">
                <i class="bi bi-key me-1"></i>Modifier le mot de passe
            </button>
        </div>

        {{ form_end(passwordForm) }}
    </div>
</div>
{% endblock %}