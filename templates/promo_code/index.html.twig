{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Gestion des codes promo{% endblock %}
{% block description %}{{ parent() }} | Gestion des codes promo{% endblock %}
{% block keywords %}{{ parent() }} | Gestion des codes promo{% endblock %}

{% block body %}
<h2>Gestion des codes promo ({{ promoCodes|length }})</h2>

<a class="btn btn-success" href="{{ path('app_admin') }}">Back Office</a>
<a class="btn btn-dark" href="{{ path('admin_promo_codes_add') }}">Ajouter un code promo</a>

{% if promoCodes is empty %}
    <div class="alert alert-info mt-3">
        Aucun code promo créé pour le moment.
    </div>
{% else %}
    <table class="table table-striped table-hover table-bordered text-center mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Réduction</th>
                <th>Appliqué à</th>
                <th>Expire le</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for promo in promoCodes %}
            <tr>
                <td>{{ promo.id }}</td>
                <td><strong>{{ promo.code }}</strong></td>
                <td>{{ promo.formattedDiscount }}</td>
                <td>
                    {% if promo.category %}
                        {{ promo.category.name }}
                    {% elseif promo.brand %}
                        {{ promo.brand.name }}
                    {% else %}
                        Tout le site
                    {% endif %}
                </td>
                <td>
                    {% if promo.endDate %}
                        {{ promo.endDate|date('d/m/Y H:i') }}
                        {% set now = 'now'|date('U') %}
                        {% set end = promo.endDate|date('U') %}
                        {% if end < now %}
                            <br><span class="fst-italic text-danger">Expiré</span>
                        {% endif %}
                    {% else %}
                        <span class="fst-italic text-muted">Permanent</span>
                    {% endif %}
                </td>
                <td>
                    <div class="form-check form-switch d-flex justify-content-center">
                        <form action="{{ path('admin_promo_codes_toggle', {id: promo.id}) }}" 
                              method="POST" 
                              style="display: inline;">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   {% if promo.isActive %}checked{% endif %}
                                   onchange="this.form.submit()">
                        </form>
                    </div>
                </td>
                <td>
                    <a href="{{ path('admin_promo_codes_edit', {id: promo.id}) }}" 
                       class="text-decoration-none">
                        <img src="{{ asset('images/edit.png') }}" alt="modifier" class="sizeSvg30">
                    </a>

                    <a href="#" 
                       class="text-decoration-none"
                       onclick="event.preventDefault(); if(confirm('Êtes-vous sûr de vouloir supprimer le code {{ promo.code }} ?')) { document.getElementById('delete-form-{{ promo.id }}').submit(); }">
                        <img src="{{ asset('images/supp.png') }}" alt="supprimer" class="sizeSvg30">
                    </a>
                    <form id="delete-form-{{ promo.id }}" 
                          action="{{ path('admin_promo_codes_delete', {id: promo.id}) }}" 
                          method="POST" 
                          style="display: none;">
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

{% endblock %}