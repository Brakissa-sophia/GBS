{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Modifier le code {{ promoCode.code }}{% endblock %}
{% block description %}{{ parent() }} | Modifier le code {{ promoCode.code }}{% endblock %}
{% block keywords %}{{ parent() }} | Modifier le code {{ promoCode.code }}{% endblock %}

{% block body %}
<h2>Modifier le code : "{{ promoCode.code }}" </h2>

<a class="btn btn-secondary" href="{{ path('admin_promo_codes_index') }}">Retour à la liste</a>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0 text-dark">Modification du code promo</h5>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.code, 'Code promo *') }}
                            {{ form_widget(form.code) }}
                            {{ form_errors(form.code) }}
                        </div>

                        <div class="col-md-3 mb-3">
                            {{ form_label(form.discountType, 'Type *') }}
                            {{ form_widget(form.discountType) }}
                            {{ form_errors(form.discountType) }}
                        </div>

                        <div class="col-md-3 mb-3">
                            {{ form_label(form.discountValue, 'Valeur *') }}
                            {{ form_widget(form.discountValue) }}
                            {{ form_errors(form.discountValue) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.endDate, 'Date d\'expiration') }}
                            {{ form_widget(form.endDate) }}
                            {{ form_errors(form.endDate) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.category, 'Catégorie') }}
                            {{ form_widget(form.category) }}
                            {{ form_errors(form.category) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.brand, 'Marque') }}
                            {{ form_widget(form.brand) }}
                            {{ form_errors(form.brand) }}
                        </div>
                    </div>

                    <small class="text-muted fst-italic">* Si ni catégorie ni marque ne sont sélectionnées, le code s'appliquera sur tout le site.</small>

                    <div class="mb-3 mt-3">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.isActive, 'Code actif', {'label_attr': {'class': 'form-check-label'}}) }}
                            {{ form_errors(form.isActive) }}
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark">Enregistrer</button>
                    <a href="{{ path('admin_promo_codes_index') }}" class="btn btn-outline-secondary">Annuler</a>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success">
                <h5 class="mb-0 text-dark">Informations</h5>
            </div>
            <div class="card-body">
                <p><strong>Code :</strong> {{ promoCode.code }}</p>
                <p><strong>Réduction :</strong> {{ promoCode.formattedDiscount }}</p>
                
                {% if promoCode.category %}
                <p><strong>Catégorie :</strong> {{ promoCode.category.name }}</p>
                {% endif %}

                {% if promoCode.brand %}
                <p><strong>Marque :</strong> {{ promoCode.brand.name }}</p>
                {% endif %}

                {% if not promoCode.category and not promoCode.brand %}
                <p><strong>Application :</strong> Tout le site</p>
                {% endif %}

                {% if promoCode.endDate %}
                <p><strong>Expire le :</strong> {{ promoCode.endDate|date('d/m/Y H:i') }}</p>
                {% endif %}

                <p><strong>Créé le :</strong> {{ promoCode.createdAt|date('d/m/Y') }}</p>
                
                <hr>
                
                <form action="{{ path('admin_promo_codes_delete', {id: promoCode.id}) }}" 
                      method="POST" 
                      onsubmit="return confirm('Supprimer le code {{ promoCode.code }} ? Cette action est irréversible.')">
                    <button type="submit" class="btn btn-danger w-100">
                        Supprimer le code
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}