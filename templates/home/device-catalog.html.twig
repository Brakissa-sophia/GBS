{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Catalogue Outils de Beauté {% endblock %}
{% block description %}{{ parent() }} | Catalogue Outils de Beauté {% endblock %}
{% block keywords %}{{ parent() }} | Catalogue Outils de Beauté {% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- MOBILE UNIQUEMENT - Bouton Filtres -->
    <div class="d-flex justify-content-between align-items-center mb-3 d-md-none">
        <h2 class="pb-2 mb-0">Outils de Beauté</h2>
        <button class="btn btn-outline-success" type="button" data-bs-toggle="offcanvas" data-bs-target="#filtresOffcanvasDevice">
            <i class="fas fa-filter me-2"></i>Filtres
        </button>
    </div>
    
    <!-- TABLETTE+ UNIQUEMENT - Titre -->
    <h2 class="pb-2 d-none d-md-block">Outils de Beauté</h2>

    <div class="row g-3">
        <!-- TABLETTE+ UNIQUEMENT - Sidebar filtres (n'existe PAS en mobile) -->
        <aside class="col-md-4 col-lg-2 d-none d-md-block bg-light p-3 rounded">
            {% if categories is defined %}
            <div class="mb-4 pt-2">
                <h4 class="d-flex justify-content-between align-items-center mb-3"
                    data-bs-toggle="collapse" data-bs-target="#categoriesCollapse" aria-expanded="true">
                    Catégories
                    <span class="toggle-icon-categories">−</span>
                </h4>
                <div class="collapse show" id="categoriesCollapse">
                    <div class="mb-2">
                        <a href="{{ path('app_device') }}"
                           class="text-decoration-none text-dark {% if selectedCategory is not defined %}text-success fw-bold{% endif %}">
                            Toutes les catégories
                        </a>
                    </div>
                    {% for category in categories %}
                        <div class="mb-2">
                            <a href="{{ path('app_universal_catalog_category', {'id': category.id}) }}"
                               class="text-decoration-none text-dark {% if selectedCategory is defined and selectedCategory.id == category.id %}text-success fw-bold{% endif %}">
                                {{ category.name }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if brands is defined %}
            <div class="mb-4">
                <h4 class="d-flex justify-content-between align-items-center mb-3"
                    data-bs-toggle="collapse" data-bs-target="#brandsCollapse" aria-expanded="false">
                    Marques
                    <span class="toggle-icon-brands">+</span>
                </h4>
                <div class="collapse" id="brandsCollapse">
                    <div class="mb-2">
                        <a href="{{ path('app_device') }}"
                           class="text-decoration-none text-dark {% if selectedBrand is not defined %}text-success fw-bold{% endif %}">
                            Toutes les marques
                        </a>
                    </div>
                    {% for brand in brands %}
                        <div class="mb-2">
                            <a href="{{ path('app_universal_catalog_brand', {'id': brand.id}) }}"
                               class="text-decoration-none text-dark {% if selectedBrand is defined and selectedBrand.id == brand.id %}text-success fw-bold{% endif %}">
                                {{ brand.title }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if skinTypes is defined %}
            <div class="mb-4">
                <h4 class="d-flex justify-content-between align-items-center mb-3"
                    data-bs-toggle="collapse" data-bs-target="#skinTypesCollapse" aria-expanded="false">
                    Types de peau
                    <span class="toggle-icon-skin">+</span>
                </h4>
                <div class="collapse" id="skinTypesCollapse">
                    <div class="mb-2">
                        <a href="{{ path('app_device') }}"
                           class="text-decoration-none text-dark {% if selectedSkinType is not defined %}text-success fw-bold{% endif %}">
                            Tous les types
                        </a>
                    </div>
                    {% for skinType in skinTypes %}
                        <div class="mb-2">
                            <a href="{{ path('app_universal_catalog_skintype', {'name': skinType.title}) }}"
                               class="text-decoration-none text-dark {% if selectedSkinType is defined and selectedSkinType.title == skinType.title %}text-success fw-bold{% endif %}">
                                {{ skinType.title }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </aside>

        <!-- MOBILE UNIQUEMENT - Offcanvas pour les filtres -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="filtresOffcanvasDevice" aria-labelledby="filtresOffcanvasDeviceLabel">
            <div class="offcanvas-header" style="background-color: var(--color-beigef);">
                <h5 class="offcanvas-title gbs_text-color" id="filtresOffcanvasDeviceLabel">Filtres</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body" style="background-color: var(--color-beige);">
                {% if categories is defined %}
                <div class="mb-4">
                    <h5 class="d-flex justify-content-between align-items-center mb-3" data-bs-toggle="collapse" data-bs-target="#categoriesCollapseDeviceMobile" aria-expanded="true">
                        Catégories
                        <span class="toggle-icon-categories-device-mobile">−</span>
                    </h5>
                    <div class="collapse show" id="categoriesCollapseDeviceMobile">
                        <div class="mb-2">
                            <a href="{{ path('app_device') }}"
                               class="text-decoration-none text-dark {% if selectedCategory is not defined %}text-success fw-bold{% endif %}">
                                Toutes les catégories
                            </a>
                        </div>
                        {% for category in categories %}
                            <div class="mb-2">
                                <a href="{{ path('app_universal_catalog_category', {'id': category.id}) }}"
                                   class="text-decoration-none text-dark {% if selectedCategory is defined and selectedCategory.id == category.id %}text-success fw-bold{% endif %}">
                                    {{ category.name }}
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if brands is defined %}
                <div class="mb-4">
                    <h5 class="d-flex justify-content-between align-items-center mb-3" data-bs-toggle="collapse" data-bs-target="#brandsCollapseDeviceMobile" aria-expanded="false">
                        Marques
                        <span class="toggle-icon-brands-device-mobile">+</span>
                    </h5>
                    <div class="collapse" id="brandsCollapseDeviceMobile">
                        <div class="mb-2">
                            <a href="{{ path('app_device') }}"
                               class="text-decoration-none text-dark {% if selectedBrand is not defined %}text-success fw-bold{% endif %}">
                                Toutes les marques
                            </a>
                        </div>
                        {% for brand in brands %}
                            <div class="mb-2">
                                <a href="{{ path('app_universal_catalog_brand', {'id': brand.id}) }}"
                                   class="text-decoration-none text-dark {% if selectedBrand is defined and selectedBrand.id == brand.id %}text-success fw-bold{% endif %}">
                                    {{ brand.title }}
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if skinTypes is defined %}
                <div class="mb-4">
                    <h5 class="d-flex justify-content-between align-items-center mb-3" data-bs-toggle="collapse" data-bs-target="#skinTypesCollapseDeviceMobile" aria-expanded="false">
                        Types de peau
                        <span class="toggle-icon-skin-device-mobile">+</span>
                    </h5>
                    <div class="collapse" id="skinTypesCollapseDeviceMobile">
                        <div class="mb-2">
                            <a href="{{ path('app_device') }}"
                               class="text-decoration-none text-dark {% if selectedSkinType is not defined %}text-success fw-bold{% endif %}">
                                Tous les types
                            </a>
                        </div>
                        {% for skinType in skinTypes %}
                            <div class="mb-2">
                                <a href="{{ path('app_universal_catalog_skintype', {'name': skinType.title}) }}"
                                   class="text-decoration-none text-dark {% if selectedSkinType is defined and selectedSkinType.title == skinType.title %}text-success fw-bold{% endif %}">
                                    {{ skinType.title }}
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Zone appareils - MOBILE: 100% largeur / TABLETTE+: 8 ou 10 colonnes -->
        <div class="col-12 col-md-8 col-lg-10">
            <div class="row g-3">
                {% if devicesWithImages is empty %}
                    <div class="col-12">
                        <p>Aucun appareil disponible pour le moment.</p>
                    </div>
                {% else %}
                    {% for item in devicesWithImages %}
                        <!-- MOBILE: col-6 (2 par ligne) / TABLETTE: col-md-4 (3 par ligne) / DESKTOP: col-lg-3 (4 par ligne) -->
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card h-100 shadow position-relative">
                                
                                {% if app.user %}
                                    <a href="{{ path('app_favorite_toggle', {itemType: 'device', itemId: item.device.id}) }}"
                                       class="btn btn-outline-danger position-absolute top-0 end-0 m-2 rounded-circle border-0"
                                       style="width: 40px; height: 40px; z-index: 2;"
                                       title="Ajouter aux favoris">
                                        <i class="far fa-heart"></i>
                                    </a>
                                {% endif %}
                                
                                {% if item.image %}
                                    <a class="text-decoration-none text-dark"
                                       href="{{ path('app_device_catalog_show_home', {'id': item.device.id}) }}">
                                        <img src="{{ asset(item.image) }}"
                                            class="card-img-top"
                                            alt="{{ item.device.title }}"
                                            loading="lazy">

                                    </a>
                                {% else %}
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                                        <span class="text-muted">Pas d'image</span>
                                    </div>
                                {% endif %}

                                <div class="card-body d-flex flex-column">
                                    <a class="text-decoration-none text-dark"
                                       href="{{ path('app_device_catalog_show_home', {'id': item.device.id}) }}">
                                        <h5 class="card-title">{{ item.device.title }}</h5>
                                    </a>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-end mb-2">
                                            <span class="text-success fw-bold">{{ item.device.price }}€</span>
                                        </div>
                                        <a href="{{ path('app_cart_add', {'type': 'device', 'id': item.device.id}) }}"
                                           class="btn btn-outline-success w-100">Ajouter au panier</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(devices, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const categoriesCollapse = document.getElementById('categoriesCollapse');
    const toggleIconCategories = document.querySelector('.toggle-icon-categories');
    if (categoriesCollapse && toggleIconCategories) {
        categoriesCollapse.addEventListener('show.bs.collapse', function () {
            toggleIconCategories.textContent = '−';
        });
        categoriesCollapse.addEventListener('hide.bs.collapse', function () {
            toggleIconCategories.textContent = '+';
        });
    }

    const brandsCollapse = document.getElementById('brandsCollapse');
    const toggleIconBrands = document.querySelector('.toggle-icon-brands');
    if (brandsCollapse && toggleIconBrands) {
        brandsCollapse.addEventListener('show.bs.collapse', function () {
            toggleIconBrands.textContent = '−';
        });
        brandsCollapse.addEventListener('hide.bs.collapse', function () {
            toggleIconBrands.textContent = '+';
        });
    }

    const skinTypesCollapse = document.getElementById('skinTypesCollapse');
    const toggleIconSkin = document.querySelector('.toggle-icon-skin');
    if (skinTypesCollapse && toggleIconSkin) {
        skinTypesCollapse.addEventListener('show.bs.collapse', function () {
            toggleIconSkin.textContent = '−';
        });
        skinTypesCollapse.addEventListener('hide.bs.collapse', function () {
            toggleIconSkin.textContent = '+';
        });
    }

    const categoriesCollapseDeviceMobile = document.getElementById('categoriesCollapseDeviceMobile');
    const toggleIconCategoriesDeviceMobile = document.querySelector('.toggle-icon-categories-device-mobile');
    if (categoriesCollapseDeviceMobile && toggleIconCategoriesDeviceMobile) {
        categoriesCollapseDeviceMobile.addEventListener('show.bs.collapse', function () {
            toggleIconCategoriesDeviceMobile.textContent = '−';
        });
        categoriesCollapseDeviceMobile.addEventListener('hide.bs.collapse', function () {
            toggleIconCategoriesDeviceMobile.textContent = '+';
        });
    }

    const brandsCollapseDeviceMobile = document.getElementById('brandsCollapseDeviceMobile');
    const toggleIconBrandsDeviceMobile = document.querySelector('.toggle-icon-brands-device-mobile');
    if (brandsCollapseDeviceMobile && toggleIconBrandsDeviceMobile) {
        brandsCollapseDeviceMobile.addEventListener('show.bs.collapse', function () {
            toggleIconBrandsDeviceMobile.textContent = '−';
        });
        brandsCollapseDeviceMobile.addEventListener('hide.bs.collapse', function () {
            toggleIconBrandsDeviceMobile.textContent = '+';
        });
    }

    const skinTypesCollapseDeviceMobile = document.getElementById('skinTypesCollapseDeviceMobile');
    const toggleIconSkinDeviceMobile = document.querySelector('.toggle-icon-skin-device-mobile');
    if (skinTypesCollapseDeviceMobile && toggleIconSkinDeviceMobile) {
        skinTypesCollapseDeviceMobile.addEventListener('show.bs.collapse', function () {
            toggleIconSkinDeviceMobile.textContent = '−';
        });
        skinTypesCollapseDeviceMobile.addEventListener('hide.bs.collapse', function () {
            toggleIconSkinDeviceMobile.textContent = '+';
        });
    }
});
</script>
{% endblock %}