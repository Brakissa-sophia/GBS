{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Catégorie fiche{% endblock %}
{% block description %}{{ parent() }} | Catégorie fiche{% endblock %}
{% block keywords %}{{ parent() }} | Catégorie fiche{% endblock %}

{% block body %}
<h2>{{ category.name|capitalize }}</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_category_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row mt-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary">
                <h5 class="mb-0 text-dark">Informations</h5>
            </div>
            <div class="card-body">
                <p><strong>ID :</strong> {{ category.id }}</p>
                <p><strong>Nom :</strong> {{ category.name }}</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-info">
                <h5 class="mb-0 text-dark">Produits de cette catégorie</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Prix (€)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in category.products %}
                            <tr>
                                <td>{{ product.id }}</td>
                                <td>{{ product.title|capitalize }}</td>
                                <td>{{ product.price }}€</td>
                                <td>
                                    <a href="{{ path('app_product_show', {'id': product.id }) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td class="text-center text-muted fst-italic" colspan="4">Aucun produit dans cette catégorie</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}