{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Ajouter une catégorie{% endblock %}
{% block description %}{{ parent() }} | Ajouter une catégorie{% endblock %}
{% block keywords %}{{ parent() }} | Ajouter une catégorie{% endblock %}

{% block body %}
<h2>Ajouter une catégorie</h2>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-dark" href="{{ path('app_category_index') }}">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary">
                <h5 class="mb-0 text-dark">Nouvelle catégorie</h5>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                
                {{ form_row(form.name) }}
                
                <button type="submit" class="btn btn-dark">Enregistrer</button>
                <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary">Annuler</a>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

{% endblock %}